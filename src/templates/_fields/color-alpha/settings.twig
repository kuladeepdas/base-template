<div id="customSwatches-field" class="field" data-color-alpha-settings>
  <div class="heading">
    <label id="customSwatches-label">{{ 'Custom swatches'|t('base-template') }}</label>
  </div>
  <div class="instructions">
    <p>{{ 'Add one or more swatches. These will appear in the field picker.'|t('base-template') }}</p>
  </div>

  <div class="input ltr">
    <textarea id="customSwatches" name="customSwatches" class="visually-hidden" data-swatches-hidden>{{ field.customSwatches ?? '' }}</textarea>

    <div class="if-settings-swatches" data-swatch-list></div>

    <button type="button" class="btn dashed add icon" data-add-swatch>
      <span class="label">{{ 'Add swatch'|t('base-template') }}</span>
    </button>
  </div>
</div>

