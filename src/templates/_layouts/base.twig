{% extends "_layouts/html" %}

{% do craft.app.view.registerAssetBundle('frontend\\assets\\Index') %}

{% block body %}
    <body {% if body_classes is defined %}class="{{ body_classes }}"{% endif %} {{ body_attr ?? '' }}>
        {{ beginBody() }}
        {% block after_body_tag %}{% endblock %}
        <header id="header" {% if header_classes is defined %}class="{{ header_classes }}"{% endif %} {{ header_attr ?? '' }}>
            {% block before_header %}
            {% endblock %}
            {% block header %}
            {% endblock %}
            {% block after_header %}
            {% endblock %}
        </header>
        <main id="content" {% if main_classes is defined %}class="{{ main_classes }}"{% endif %}>
            {% block messages %}
                {% include "_includes/messages" %}
            {% endblock %}
            {% block before_content %}
            {% endblock %}
            {% block content %}
            {% endblock %}
            {% block after_content %}
            {% endblock %}
        </main>
        <footer id="footer" {% if footer_classes is defined %}class="{{ footer_classes }}"{% endif %} {{ footer_attr ?? '' }}>
            {% block before_footer %}
            {% endblock %}
            {% block footer %}
            {% endblock %}
            {% block after_footer %}
            {% endblock %}
        </footer>
        {% block modals %}{% endblock %}
        {% block before_end_body_tag %}{% endblock %}
        {{ endBody() }}
    </body>
{% endblock %}
