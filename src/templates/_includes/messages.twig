{% set messages = messages ?? [] %}
{% set message = craft.app.session.getFlash('notice', false, true) %}
{% if message %}
    {% set messages = messages|merge([{type: 'success', message: message}]) %}
{% endif %}
{% set message = craft.app.session.getFlash('error', false, true) %}
{% if message %}
    {% set messages = messages|merge([{type: 'danger', message: message}]) %}
{% endif %}

<div class="account-messages container">
    {% for message in messages %}
        <div class="alert alert-{{ message.type }} alert-dismissible fade show auto-dismiss"
                role="alert">
            {{ message.message|raw }}
            <button type="button" class="close" data-dismiss="alert" aria-label="Close">
                <span aria-hidden="true">&times;</span>
            </button>
        </div>
    {% endfor %}
</div>
