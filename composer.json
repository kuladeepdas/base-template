{
    "name": "kdgraphics/base-template",
    "version": "1.0.0",
    "description": "Frontend assets and build management for Craft CMS.",
    "type": "craft-plugin",
    "keywords": [
        "craft",
        "cms",
        "craftcms"
    ],
    "require": {
        "php": "^8.2",
        "craftcms/cms": "^5.0",
        "putyourlightson/craft-blitz-hints": "*"
    },
    "autoload": {
        "psr-4": {
            "Kdgraphics\\BaseTemplate\\": "src/"
        }
    },
    "extra": {
        "name": "Base Template",
        "handle": "base-template",
        "class": "Kdgraphics\\BaseTemplate\\BaseTemplate"
    }
}
